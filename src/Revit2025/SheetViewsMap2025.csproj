<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Проект для одной версии Revit.
    Исходники общие для всех версий и лежат в папке src\Shared.
    Версия Revit задаётся при сборке: dotnet build ... -p:RevitVersion=2025
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>SheetViewsMap2025</AssemblyName>
    <RootNamespace>SheetViewsMap</RootNamespace>
    <Product>Sheet Views Map</Product>
    <Company>SheetViewsMap</Company>
    <Version>1.0.0</Version>
    <NeutralLanguage>ru-RU</NeutralLanguage>
    <DebugType>portable</DebugType>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\..\out\$(RevitVersion)\</OutputPath>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2025</RevitVersion>
    <RevitDir>$(ProgramFiles)\Autodesk\Revit $(RevitVersion)\</RevitDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Общий код: подключаем те же самые файлы, что и в проекте для другой версии. -->
    <Compile Include="..\Shared\**\*.cs" LinkBase="Shared" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Пакет нужен, чтобы сборка .NET Framework 4.8 работала без Visual Studio
      (dotnet build сам скачает эталонные сборки .NET Framework).
    -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Эталонные сборки Revit 2025 для сборки без установленного Revit 2025.
      Файлы пакета сами по себе не подключаются (ExcludeAssets="all"): пути
      к DLL берутся через свойство PkgRevit_All_Main_Versions_API_x64 ниже.
    -->
    <PackageReference Include="Revit_All_Main_Versions_API_x64" Version="2025.0.0" PrivateAssets="all" ExcludeAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Ссылки на API Revit: сначала из установленного Revit, если он есть,
      иначе - из NuGet-пакета выше.
      Private=false обязательно: DLL Revit копировать в выходную папку нельзя,
      иначе Revit загрузит не ту сборку.
    -->
    <Reference Include="RevitAPI">
      <HintPath Condition="Exists('$(RevitDir)RevitAPI.dll')">$(RevitDir)RevitAPI.dll</HintPath>
      <HintPath Condition="!Exists('$(RevitDir)RevitAPI.dll') and Exists('$(PkgRevit_All_Main_Versions_API_x64)\lib\net8.0\RevitAPI.dll')">$(PkgRevit_All_Main_Versions_API_x64)\lib\net8.0\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath Condition="Exists('$(RevitDir)RevitAPIUI.dll')">$(RevitDir)RevitAPIUI.dll</HintPath>
      <HintPath Condition="!Exists('$(RevitDir)RevitAPIUI.dll') and Exists('$(PkgRevit_All_Main_Versions_API_x64)\lib\net8.0\RevitAPIUI.dll')">$(PkgRevit_All_Main_Versions_API_x64)\lib\net8.0\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- WPF: панель построена на XAML-контролах, собираемых в коде. -->
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
  </ItemGroup>

</Project>
