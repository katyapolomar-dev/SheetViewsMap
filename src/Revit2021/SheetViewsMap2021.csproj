<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Проект для одной версии Revit.
    Исходники общие для всех версий и лежат в папке src\Shared.
    Версия Revit задаётся при сборке: dotnet build ... -p:RevitVersion=2021
    (по умолчанию 2021)
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>SheetViewsMap2021</AssemblyName>
    <RootNamespace>SheetViewsMap</RootNamespace>
    <Product>Sheet Views Map</Product>
    <Company>SheetViewsMap</Company>
    <NeutralLanguage>ru-RU</NeutralLanguage>
    <DebugType>portable</DebugType>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\..\out\$(RevitVersion)\</OutputPath>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2021</RevitVersion>
    <RevitDir>$(ProgramFiles)\Autodesk\Revit $(RevitVersion)\</RevitDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Общий код: подключаем те же самые файлы, что и в проекте для другой версии. -->
    <Compile Include="..\Shared\**\*.cs" LinkBase="Shared" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Пакет нужен, чтобы сборка .NET Framework 4.8 работала без Visual Studio
      (dotnet build сам скачает эталонные сборки .NET Framework).
    -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Ссылки на API Revit берём из установленного Revit.
      Private=false обязательно: DLL Revit копировать в выходную папку нельзя,
      иначе Revit загрузит не ту сборку.
    -->
    <Reference Include="RevitAPI">
      <HintPath>$(RevitDir)RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitDir)RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- WPF: панель построена на XAML-контролах, собираемых в коде. -->
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />

    <!-- Проверка обновлений: разбор ответа GitHub API и скачивание. -->
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

</Project>